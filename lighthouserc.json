{
  "ci": {
    "collect": {
      "url": [
        "https://www.bellops.in/",
        "https://www.bellops.in/premium-website-design",
        "https://www.bellops.in/work",
        "https://www.bellops.in/contact"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2500, "aggregationMethod": "median-run" }
        ],
        "total-byte-weight": [
          "error",
          { "maxNumericValue": 1500000, "aggregationMethod": "median-run" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-reports"
    }
  }
}
