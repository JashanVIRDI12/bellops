# Public production origin for canonical URLs, share previews and sitemap.
NEXT_PUBLIC_SITE_URL=https://www.bellops.in

# Optional: paste only the verification-token content values from the providers.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Admin portal (/admin) ──────────────────────────────────────────────────
# The password for /admin/login. Leave empty to keep the portal switched off.
ADMIN_PASSWORD=
# Optional: a long random string that signs admin sessions
# (for example: openssl rand -base64 32). Without it, sessions are signed with
# a key derived from ADMIN_PASSWORD, so changing the password signs everyone out.
ADMIN_SESSION_SECRET=
# Optional: the time zone enquiry times are shown in. Defaults to Asia/Kolkata.
ADMIN_TIME_ZONE=

# ── Database: Supabase ─────────────────────────────────────────────────────
# Enquiries are saved here. In your Supabase project: the URL is in the
# Connect dialog (https://<project>.supabase.co, without /rest/v1), and the
# secret key (sb_secret_…) is under Settings → API Keys → Secret keys.
# Connecting Supabase from Vercel's Storage tab fills these in for you.
# Keep the secret key private: never prefix it with NEXT_PUBLIC_.
# Without them, local development saves to .data/leads.json instead.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Optional: an email for every new enquiry, sent through resend.com ──────
RESEND_API_KEY=
# Who gets the email. Separate several addresses with commas.
LEADS_NOTIFY_TO=
# The sender. Needs a domain verified in Resend; until then, Resend's test
# sender only delivers to your own Resend account's address.
LEADS_NOTIFY_FROM=

# ── Analytics (stored in Supabase, no cookies) ─────────────────────────────
# Optional: a long random string for the daily visitor hash. Defaults to a
# key derived from SUPABASE_SECRET_KEY.
ANALYTICS_SALT=
# Visits from localhost aren't counted. Set to 1 to count them while testing.
ANALYTICS_IN_DEV=
